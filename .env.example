# =========================================================================
# NEUROXLAB CMS & ADMIN PORTAL ENVIRONMENT CONFIGURATION
# =========================================================================
# The NeuroXLab CMS operates with dual-mode architecture:
# 1. Supabase Cloud PostgreSQL Mode (when VITE_SUPABASE_URL and KEY are set)
# 2. High-Performance Local Persistent Engine (IndexedDB + WebCrypto fallback)
#
# When running locally or during initial deployment, the local persistent engine
# provides full admin authentication, password hashing, session control, RBAC,
# media uploads, audit logs, and automatic data seeding.
# =========================================================================

# Supabase Project URL (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=

# Supabase Public Anon Key (from your Supabase Project Settings -> API)
VITE_SUPABASE_ANON_KEY=

# Optional: Custom Media Storage Bucket name (default: neuroxlab-media)
VITE_SUPABASE_STORAGE_BUCKET=neuroxlab-media

# Optional: Laboratory Contact & Notification Email
VITE_LAB_ADMIN_EMAIL=nvprasuja@uohyd.ac.in

